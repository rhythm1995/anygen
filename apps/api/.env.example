# @helix/api env (copy to .env). Inherits the same vars as the root .env.example.
HELIX_MODE=mock
API_PORT=4000
NODE_ENV=development

# The default org id resolves the tenant when no x-org-id header is supplied.
HELIX_ORG_ID=00000000-0000-0000-0000-000000000001

# Supabase (required when HELIX_MODE=supabase)
SUPABASE_URL=http://localhost:54321
SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key
DATABASE_URL=postgresql://postgres:postgres@localhost:54322/postgres

# eve agent service (when absent or no model key → stub generator is used)
EVE_API_URL=http://localhost:3040
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
HELIX_MODEL_DRAFT=openai/gpt-4o-mini
HELIX_MODEL_QUALITY=anthropic/claude-sonnet-4-5
