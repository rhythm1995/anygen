# @helix/agent env (copy to .env)
# The eve agent runs fully self-hosted (zero Vercel infra) — see vercel-labs/steve.

# ── Model provider (pick one) ─────────────────────────────────────────────
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
HELIX_MODEL_DRAFT=gpt-4o-mini
HELIX_MODEL_QUALITY=claude-sonnet-4-5

# ── Helix API (the agent's tools call back here for KB / compliance) ──────
HELIX_API_URL=http://localhost:4000
HELIX_ORG_ID=00000000-0000-0000-0000-000000000001

# ── Durable execution: self-hosted Postgres Workflow world ────────────────
# These three are REQUIRED for self-hosted durability and are version-coupled
# to `eve@0.15.0` + `@workflow/world-postgres@5.0.0-beta.19` (see Gotchas).
WORKFLOW_POSTGRES_URL=postgresql://postgres:postgres@localhost:5432/helix
WORKFLOW_TARGET_WORLD=@workflow/world-postgres
WORKFLOW_QUEUE_NAMESPACE=eve

# ── Runtime ───────────────────────────────────────────────────────────────
AGENT_PORT=3040
NODE_ENV=development
