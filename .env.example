# ── Helix root env (copy to .env, and per-app .env as needed) ──────────────

# Run mode: "supabase" uses a real/local Supabase project; "mock" runs fully
# offline with an in-memory store + stub content generator (no keys needed).
HELIX_MODE=mock

# ── Supabase (required when HELIX_MODE=supabase) ──────────────────────────
# Local `supabase start` prints these. Cloud: your project settings.
SUPABASE_URL=http://localhost:54321
SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key
# Direct Postgres DSN — also used by the eve agent for durable workflows.
DATABASE_URL=postgresql://postgres:postgres@localhost:54322/postgres

# ── eve agent service ─────────────────────────────────────────────────────
EVE_API_URL=http://localhost:3040
# When EVE_API_URL or a model key is absent, the API falls back to a stub
# generator so the dashboard + pipeline still work end-to-end.

# ── Model provider (for the eve agent; pick one) ──────────────────────────
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
# Any model string supported by the Vercel AI SDK provider you configure.
HELIX_MODEL_DRAFT=openai/gpt-4o-mini
HELIX_MODEL_QUALITY=anthropic/claude-sonnet-4-5

# ── Services ──────────────────────────────────────────────────────────────
API_PORT=4000
WEB_PORT=3000
AGENT_PORT=3040
NODE_ENV=development
